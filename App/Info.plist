<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>HormeIDBase</key><string>$(HORME_ID_BASE)</string>
    <key>CKSharingSupported</key><true/>
    <!-- Siri and VoiceOver say and hear the app as ホルメ, not as the English letters. -->
    <key>CFBundleSpokenName</key><string>ホルメ</string>
    <key>INAlternativeAppNames</key>
    <array>
        <dict>
            <key>INAlternativeAppName</key><string>ホルメ</string>
            <key>INAlternativeAppNamePronunciationHint</key><string>ほるめ</string>
        </dict>
    </array>
    <key>NSSupportsLiveActivities</key><true/>
    <key>HormeInboxGroup</key><string>$(AppIdentifierPrefix)$(HORME_ID_BASE).inbox</string>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key><string>LaunchBackground</string>
    </dict>
    <key>UIBackgroundModes</key><array><string>remote-notification</string></array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>$(HORME_ID_BASE)</string>
            <key>CFBundleURLSchemes</key><array><string>horme</string></array>
        </dict>
    </array>
</dict>
</plist>
